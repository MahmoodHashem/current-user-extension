{
  "manifest_version": 3,
  "name": "GitHub Account Identity & Guard",
  "version": "2.0.0",
  "description": "Shows current account identity on issues/PRs and blocks wrong-account interactions.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://github.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub Account Guard — manage accounts"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon16.png",
    "128": "icons/icon16.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["https://github.com/*"]
    }
  ]
}
